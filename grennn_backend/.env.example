# ── 服务配置 ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
CALLBACK_URL_BASE=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

# 管理员邮箱（逗号分隔）；留空则没有管理员账号
ADMIN_EMAILS=

# 本地调试：是否在响应中返回密码重置令牌（生产环境必须为 false）
AUTH_DEBUG_RESET=false

# ── MySQL ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=greensight
# 仅开发环境需要修改表结构时设为 true
DB_SYNC_ALTER=false

# ── AI 服务 ──────────────────────────────────────────────
FASTAPI_BASE_URL=http://127.0.0.1:8003
AI_SERVICE_URL=http://127.0.0.1:8003
AI_MAX_CONCURRENCY=4
AI_MAX_IMAGE_BYTES=5242880
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
SILICONFLOW_TIMEOUT=60
GLM_API_KEY=
GLM_MODEL=glm-4-flash

# ── 邮件（SMTP）──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GreenSight <no-reply@example.com>

# ── OAuth（可选）─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
