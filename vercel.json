{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix grennn_web ci",
  "buildCommand": "npm --prefix grennn_web run build",
  "outputDirectory": "grennn_web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
